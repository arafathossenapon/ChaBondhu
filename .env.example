# Core Environment Settings
NODE_ENV=development               # Node.js environment (development | staging | production)
NODE_DB_ENV=development            # Database environment mode; ensures correct DB selection
JWT_BEARER_SECRET="your_jwt_secret_here_replace_in_local_env" # Secret key for signing/verifying JWT bearer tokens
PORT=5001                          # Port on which the backend HTTP server will run

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# Database Configuration (PostgreSQL)
DB_CLIENT="postgres"
DB_DATABASE="chabondhu_db"
DB_USER="postgres"
DB_PASSWORD="your_postgres_password"
DB_HOST="localhost"
DB_PORT="5432"

# Optional Cache / Queue Settings (Not mandatory for MVP bootstrap)
REDIS_PORT=6379
REDIS_HOST="localhost"
REDIS_URL=
